#!/usr/bin/env bash
# Incrémente automatiquement le patch de version à chaque commit (≈ chaque évolution)
# et l'inscrit dans version.json + le <span class="app-ver"> de index.html, dans le
# même commit. Aucune dépendance (bash + grep/sed), pour tourner partout.
#
# Activation (une fois par clone) :  git config core.hooksPath .githooks
set -e

ROOT="$(git rev-parse --show-toplevel)"
VF="$ROOT/version.json"
IDX="$ROOT/index.html"
[ -f "$VF" ] || exit 0

CUR="$(grep -oE '[0-9]+\.[0-9]+\.[0-9]+' "$VF" | head -1)"
[ -n "$CUR" ] || exit 0
MAJOR="${CUR%%.*}"; REST="${CUR#*.}"; MINOR="${REST%%.*}"; PATCH="${REST#*.}"
NEW="$MAJOR.$MINOR.$((PATCH + 1))"

printf '{"version": "%s"}' "$NEW" > "$VF"
# Met à jour le numéro affiché (sed BRE, échappements explicites)
sed -i "s#<span class=\"app-ver\">v[0-9.]\+</span>#<span class=\"app-ver\">v$NEW</span>#" "$IDX"

git add "$VF" "$IDX"
echo "[version] v$CUR -> v$NEW"
