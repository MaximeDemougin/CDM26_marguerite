#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/version.json"
INDEX_FILE="$REPO_ROOT/index.html"

# Read and increment patch
CURRENT=$(python3 -c "import json; print(json.load(open('$VERSION_FILE'))['version'])")
NEW=$(python3 -c "
v = '$CURRENT'.split('.')
v[2] = str(int(v[2]) + 1)
print('.'.join(v))
")

# Update version.json
python3 -c "import json; json.dump({'version':'$NEW'}, open('$VERSION_FILE','w'))"

# Update app-ver span in index.html
python3 - "$INDEX_FILE" "$NEW" <<'EOF'
import sys, re
path, ver = sys.argv[1], sys.argv[2]
content = open(path).read()
content = re.sub(r'(<span class="app-ver">)v[\d.]+(<\/span>)', rf'\g<1>v{ver}\2', content)
open(path, 'w').write(content)
EOF

# Commit the bump
git add "$VERSION_FILE" "$INDEX_FILE"
git commit -m "chore: bump version to v$NEW"

echo "[version] v$CURRENT → v$NEW"
